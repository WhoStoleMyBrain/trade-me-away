# PAPER is the default/recommended setup. Missing or invalid mode fails startup.
TRADING_MODE=paper
TRADER_CONFIG=config.yaml
TRADER_DB=var/trader.sqlite3
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Optional overrides; a different model also requires matching pricing in config.yaml.
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=medium

# CDP ECDSA key, scoped to one Advanced Trade spot portfolio, view + trade, NO transfer.
COINBASE_MAIN_PORTFOLIO_ID=REPLACE_WITH_PORTFOLIO_UUID
COINBASE_MAIN_API_KEY=REPLACE_WITH_CDP_KEY_NAME
COINBASE_MAIN_API_SECRET="REPLACE_WITH_ECDSA_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"
